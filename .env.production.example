# ============================================================
# Teman Belajar Udinus — PRODUCTION Environment (VPS)
# ============================================================
# Salin file ini menjadi .env pada server produksi:
#   cp .env.production.example .env
# Lalu WAJIB:
#   1. php artisan key:generate        (generate APP_KEY baru)
#   2. Isi DB_PASSWORD yang kuat
#   3. Sesuaikan APP_URL dengan domain Anda
#
# PERINGATAN: APP_DEBUG=false di produksi agar error detail
# tidak tampil ke pengguna.
# ============================================================

APP_NAME="Teman Belajar Udinus"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Ganti dengan subdomain Anda, mis: https://temanbelajar.namadomain.com
APP_URL=https://temanbelajar.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Maintenance driver: gunakan "file" untuk VPS single.
# "database" butuh tabel maintenance tersendiri dan sering menyebabkan
# error "Driver [database] not supported" jika belum siap.
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# BCRYPT_ROUNDS lebih tinggi = lebih aman tapi lebih lambat.
# 12 aman untuk VPS biasa.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----- Database (MySQL di VPS) -----
# Buat database & user MySQL terpisah, jangan pakai root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teman_belajar_udinus
DB_USERNAME=teman_belajar
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Session & cache: database (sudah dimigrasi) atau redis untuk performa.
# SESSION_DOMAIN: isi dengan subdomain Anda (tanpa https://).
#   - Subdomain tunggal: temanbelajar.namadomain.com
#   - Agar cookie berlaku juga untuk sub-subdomain: .namadomain.com (dengan titik di depan)
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production di HTTPS: enkripsi session + secure cookie.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=temanbelajar.example.com

# Reverse proxy yang dipercaya. VPS single (Nginx di localhost):
TRUSTED_PROXIES=127.0.0.1,::1
# Jika app menerima koneksi langsung dari Cloudflare (tanpa Nginx di depan),
# tambahkan range IP CF. JANGAN pakai *.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=teman_belajar_

# ----- Mail (SMTP) -----
# Gunakan SMTP sungguhan (mis. Mailtrap untuk testing, atau
# penyedia email transaksional seperti Mailgun/Sendgrid/Brevo).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@temanbelajar.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
